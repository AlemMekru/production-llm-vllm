# LLM provider options:
# mock = local fake response for development
# vllm = real vLLM OpenAI-compatible server
LLM_PROVIDER=mock

# vLLM OpenAI-compatible API endpoint
VLLM_BASE_URL=http://localhost:8001/v1

# vLLM does not require a real key locally by default
VLLM_API_KEY=EMPTY

# Default model served by vLLM
DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Gateway timeout
REQUEST_TIMEOUT_SECONDS=120

# Required only for gated Hugging Face models such as Llama
HUGGING_FACE_HUB_TOKEN=
